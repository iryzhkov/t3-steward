# Example systemd user unit. `t3-steward install-service` generates
# the real one with absolute paths; this copy documents the shape.
#
# Install manually:
#   cp t3-steward.service ~/.config/systemd/user/
#   edit ExecStart and the PATH line
#   systemctl --user daemon-reload
#   systemctl --user enable --now t3-steward.service

[Unit]
Description=T3 quota watchdog (stops T3 agent sessions before the provider quota runs out)
Documentation=https://github.com/iryzhkov/t3-steward
# Start after the T3 server and stop together with it when it runs as a
# user unit named t3code.service. Remove both lines otherwise.
After=t3code.service
PartOf=t3code.service

[Service]
Type=simple
ExecStart=%h/.local/bin/t3-steward run --config %h/.config/t3-steward/config.yaml
Restart=on-failure
RestartSec=5
# The default token command runs the t3 CLI, which needs node on PATH.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
